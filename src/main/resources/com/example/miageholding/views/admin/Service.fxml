<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.miageholding.controllers.administrateur.ServiceController"
            prefWidth="900.0" prefHeight="600.0"
            stylesheets="@../../css/theme.css, @../../css/main.css">

    <top>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>

            <Label text="Gestion des Services" styleClass="title-page"/>

            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <Label text="ID Service :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="textIdService" promptText="ex: SRV001" styleClass="text-field"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Libellé :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="textLibelle" promptText="ex: Service RH" styleClass="text-field"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Localisation :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="textLocalisation" promptText="ex: Bâtiment A - 1er étage" styleClass="text-field"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <HBox spacing="12" alignment="CENTER" GridPane.rowIndex="3" GridPane.columnSpan="4">
                    <Button text="Ajouter" onAction="#handleAjouterService" styleClass="btn-success"/>
                    <Button text="Modifier" onAction="#handleModifierService" styleClass="btn-warning"/>
                    <Button text="Supprimer" onAction="#handleSupprimerService" styleClass="btn-danger"/>
                    <Button text="Vider" onAction="#handleClearForm" styleClass="btn-neutral"/>
                </HBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍 Recherche :" />
                <TextField fx:id="textRecherche" promptText="Rechercher un service..." prefWidth="300"
                           styleClass="text-field-search"/>
            </HBox>

            <TableView fx:id="tableServices" prefHeight="400" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colIdService" text="ID" prefWidth="120"/>
                    <TableColumn fx:id="colLibelle" text="Libellé" prefWidth="300"/>
                    <TableColumn fx:id="colLocalisation" text="Localisation" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
