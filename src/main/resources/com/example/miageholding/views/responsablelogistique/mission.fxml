<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.miageholding.controllers.responsablelogistique.MissionController"
      spacing="20" alignment="TOP_CENTER"
      styleClass="page"
      stylesheets="@../../css/theme.css, @../../css/main.css">

   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>

   <!-- Titre -->
   <Label text="🛣️ Gestion des Missions" styleClass="title-page"/>

   <!-- Formulaire -->
   <TitledPane text="Informations Mission" expanded="true">
   <content>
   <GridPane hgap="25" vgap="15">
      <columnConstraints>
         <ColumnConstraints percentWidth="25"/>
         <ColumnConstraints percentWidth="75"/>
      </columnConstraints>

      <Label text="🆔 ID Mission :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <TextField fx:id="textIdMission" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

      <Label text="🚗 Véhicule :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <ComboBox fx:id="comboVehicule" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

      <Label text="📋 Libellé Mission :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
      <TextField fx:id="textLibMission" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

      <Label text="📅 Date Début :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
      <DatePicker fx:id="dateDebutMission" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

      <Label text="📅 Date Fin :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
      <DatePicker fx:id="dateFinMission" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

      <Label text="💰 Coût Mission (FCFA) :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
      <TextField fx:id="textCoutMission" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

      <Label text="⛽ Coût Carburant (FCFA) :" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
      <TextField fx:id="textCoutCarburant" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

      <Label text="🗺️ Circuit :" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
      <TextField fx:id="textCircuit" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

      <Label text="📝 Observation :" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
      <TextField fx:id="textObservation" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
   </GridPane>
   </content>
   </TitledPane>

   <!-- Boutons d'action -->
   <HBox spacing="15" alignment="CENTER">
      <Button text="Ajouter" fx:id="btnAjouter" onAction="#handleAjouterMission" styleClass="btn-success"/>
      <Button text="Modifier" fx:id="btnModifier" onAction="#handleModifierMission" styleClass="btn-warning"/>
      <Button text="Supprimer" fx:id="btnSupprimer" onAction="#handleSupprimerMission" styleClass="btn-danger"/>
      <Button text="Vider" fx:id="btnClearForm" onAction="#handleClearForm" styleClass="btn-gray"/>
   </HBox>

   <!-- Recherche -->
   <HBox spacing="10" alignment="CENTER_LEFT">
      <Label text="🔍 Recherche :" styleClass="label"/>
      <TextField fx:id="textRecherche" promptText="Rechercher une mission..." prefWidth="300"/>
   </HBox>

   <!-- TableView -->
   <TableView fx:id="tableMission" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="colIdMission" text="🆔 ID" prefWidth="80"/>
         <TableColumn fx:id="colVehicule" text="🚗 Véhicule" prefWidth="150"/>
         <TableColumn fx:id="colLibelle" text="📋 Libellé" prefWidth="180"/>
         <TableColumn fx:id="colDateDebut" text="📅 Début" prefWidth="120"/>
         <TableColumn fx:id="colDateFin" text="📅 Fin" prefWidth="120"/>
         <TableColumn fx:id="colCircuit" text="🗺️ Circuit" prefWidth="150"/>
      </columns>
   </TableView>

</VBox>
