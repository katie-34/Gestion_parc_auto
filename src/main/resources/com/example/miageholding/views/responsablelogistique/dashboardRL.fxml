<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700" prefWidth="1100" stylesheets="@../../css/theme.css, @../../css/main.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.miageholding.controllers.responsablelogistique.dashbordRLController">

   <children>
      <!-- Sidebar -->
      <AnchorPane prefHeight="700.0" prefWidth="250.0" styleClass="sidebar">
         <VBox layoutX="8.0" prefHeight="653.0" prefWidth="234.0" spacing="15" AnchorPane.leftAnchor="8.0" AnchorPane.topAnchor="30">
            <children>
               <!-- Logo -->
               <ImageView fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                  <image>
                     <Image url="@../../img/logo_miage_holding.png" />
                  </image>
               </ImageView>

               <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="34.0" prefWidth="228.0" styleClass="menu-title" text="MENU" />

               <!-- Boutons -->
               <Button onAction="#goToAccueilRL" prefHeight="38.0" prefWidth="127.0" styleClass="btnD1" text="ACCUEIL" textAlignment="JUSTIFY" />
               <Button onAction="#goToVehicule" styleClass="btnD1" text="VEHICULE" />
               <Button onAction="#goToAssurancesVehicules" styleClass="btnD1" text="ASSURANCE VEHICULE" />
               <Button onAction="#goToPersonnel" styleClass="btnD1" text="ATTRIBUTION MISSION" />
               <Button onAction="#goToMission" styleClass="btnD1" text="MISSION" />
               <Button onAction="#goToEntretien" styleClass="btnD1" text="ENTRETIEN" />
               <Button onAction="#goToAttributionVehicule" styleClass="btnD1" text="ATTRIBUTION VEHICULE" />

               <!-- Espace vide -->
               <Region prefHeight="100" VBox.vgrow="ALWAYS" />

               <!-- Bouton déconnexion -->
               <Button onAction="#logout" styleClass="btnLogout" text="SE DECONNECTER" />
            </children>
         </VBox>
      </AnchorPane>

      <!-- Content area -->
      <AnchorPane fx:id="contentArea" layoutX="250.0" layoutY="0.0" prefHeight="700.0" prefWidth="850.0" styleClass="content-area" />
   </children>
</AnchorPane>
